# ---- App ----
NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Kolkata
# Used to build absolute image URLs in API responses
PUBLIC_BASE_URL=http://localhost:5000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=home_services
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- CORS ----
# Comma-separated list of exact frontend origins (no wildcard)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# DEV ONLY: allow pages opened directly from disk (file://, Origin: null). Ignored in production.
CORS_ALLOW_FILE_ORIGIN=false

# ---- Security / limits ----
# Set to 1 when running behind Nginx / a load balancer
TRUST_PROXY=0
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
UPLOAD_MAX_MB=2
